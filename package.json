{
  "name": "chef-gringo-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/scaler.test.mjs tests/knowledge.test.mjs tests/rendered-html.test.mjs tests/marketplace.test.mjs tests/knowledge-core.test.mjs tests/knowledge-core-api.test.mjs tests/product-harvest.test.mjs tests/partner-intelligence.test.mjs tests/decision-engine.test.mjs tests/decision-case-service.test.mjs tests/case-runner.test.mjs tests/intelligence-lab.test.mjs tests/growth-foundation.test.mjs tests/partner-hunt-workflow.test.mjs",
    "test:migrations": "node --test --test-name-pattern=\"migrations apply cleanly\" tests/knowledge-core.test.mjs",
    "marketplace:harvest": "node scripts/marketplace-research/run-harvest.mjs",
    "marketplace:verify-links": "node scripts/marketplace-research/verify-links.mjs",
    "intelligence:case": "node scripts/intelligence/run-case.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
