NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Loops early access (idempotent update-or-create): https://app.loops.so/api/v1/contacts/update
EARLY_ACCESS_ENDPOINT=
# Loops API key (server-side bearer token)
EARLY_ACCESS_TOKEN=
# Backwards-compatible email adapter fallback
EMAIL_SUBSCRIBE_ENDPOINT=
EMAIL_SUBSCRIBE_TOKEN=
# Comma-separated server-only Marketplace administrator emails. Invalid or empty values deny all admin access.
MARKETPLACE_ADMIN_EMAILS=
# OpenAI-compatible chat completions for Ask Chef Gringo. Names only — never commit real values.
CHEF_GRINGO_AI_BASE_URL=
CHEF_GRINGO_AI_MODEL=
CHEF_GRINGO_AI_API_KEY=
# Public Stripe Payment Link URL. Use a test_ link until the paid pilot is approved for launch.
DECISION_BRIEF_CHECKOUT_URL=
# Server-only signing secret for /api/payment-webhooks/stripe. Never expose or commit the real value.
STRIPE_WEBHOOK_SECRET=
# Governed corpus retrieval. All default off. Names only — never commit real tokens.
CHEF_GRINGO_LOCAL_CORPUS_ENABLED=false
CHEF_GRINGO_CORPUS_RETRIEVAL_ENABLED=false
CHEF_GRINGO_CORPUS_INGEST_FETCH_ENABLED=false
CHEF_GRINGO_AI_SEARCH_INSTANCE=
CHEF_GRINGO_CORPUS_DAILY_REQUEST_CEILING=50
# Bounded live candidate discovery. Default off. Names only — never commit tokens.
# Requires an HTTPS JSON search endpoint: GET ?q=&limit= returning { results: [{ url, title, snippet? }] }.
# Cloudflare AI Search is corpus retrieval, not live web search, and is not this adapter.
CHEF_GRINGO_LIVE_CANDIDATE_DISCOVERY=false
CHEF_GRINGO_LIVE_SEARCH_ENDPOINT=
CHEF_GRINGO_LIVE_SEARCH_TOKEN=
# Preview/local corpus import. Names only. Never commit real D1 ids or reviewer tokens.
CHEF_GRINGO_CORPUS_REVIEWER_EMAIL=
CHEF_GRINGO_PREVIEW_D1_CONFIRM=
